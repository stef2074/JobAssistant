<fieldset class="border rounded p-3 pt-1 mb-2">
    <legend class="float-none w-auto px-2 fs-5">
        <strong>My Jobs</strong>
    </legend>

    <div class="mb-2">
        <label class="form-label" for="employer">Employer</label>
        <input id="employer"
               class="form-control"
               type="text"
               @bind="_jobEditState.Employer" />
    </div>

    <div class="mb-2">
        <label class="form-label" for="city">City</label>
        <input id="city"
               class="form-control"
               type="text"
               disabled="@_jobEditState.IsRemote"
               @bind="_jobEditState.City" />
    </div>

    <div class="mb-2">
        <label class="form-label" for="state">State</label>
        <select id="state"
                class="form-select"
                disabled="@_jobEditState.IsRemote"
                @bind="_jobEditState.State">
            <option value="">Select State</option>

            @foreach (string state in States)
            {
                <option value="@state">@state</option>
            }
        </select>
    </div>

    <div class="mb-2">
        <label class="form-label" for="officialJobTitle">Official Job Title</label>
        <input id="officialJobTitle"
               class="form-control"
               type="text"
               @bind="_jobEditState.OfficialJobTitle" />
    </div>

    <div class="mb-2">
        <div class="form-check">
            <input id="remote"
                   class="form-check-input"
                   type="checkbox"
                   @bind="_jobEditState.IsRemote"
                   @bind:after="RemoteChanged" />

            <label class="form-check-label" for="remote">
                Remote Position
            </label>
        </div>
    </div>

    <div class="row">
        <div class="col-md-2">
            <label class="form-label" for="startDate">Start Date</label>
            <input id="startDate"
                   class="form-control"
                   type="month"
                   @bind="_jobEditState.StartDate"
                   @bind:format="yyyy-MM" />
        </div>

        <div class="col-md-2">
            <label class="form-label" for="endDate">End Date</label>
            <input id="endDate"
                   class="form-control"
                   type="month"
                   disabled="@_jobEditState.IsCurrentPosition"
                   @bind="_jobEditState.EndDate"
                   @bind:format="yyyy-MM" />

            <div class="form-check mt-2">
                <input id="currentPosition"
                       class="form-check-input"
                       type="checkbox"
                       @bind="_jobEditState.IsCurrentPosition"
                       @bind:after="CurrentPositionChanged" />

                <label class="form-check-label" for="currentPosition">
                    Current Position
                </label>
            </div>
        </div>
    </div>

    <fieldset class="border rounded p-3 pt-1 mb-2">
        <legend class="float-none w-auto px-2 fs-5">Highlights</legend>

        <div style="display: grid; grid-template-columns: minmax(0, 1fr) 70px; gap: 0.75rem; align-items: center; padding-right: 1.25rem;">
            <input id="highlight"
                   class="form-control"
                   type="text"
                   @bind="_jobEditState.Highlight" />

            <button type="button"
                    class="btn btn-sm btn-success"
                    style="height: 31px; padding: 0; width: 100%; transform: translateX(-4px);"
                    @onclick="AddHighlight">
                Add
            </button>
        </div>

        @if (_jobEditState.Highlights.Count > 0)
        {
            <div style="max-height: 240px; overflow-y: auto; padding-right: 0.5rem;">
                @foreach (string highlight in _jobEditState.Highlights)
                {
                    <div class="border-bottom py-2"
                         style="display: grid; grid-template-columns: minmax(0, 1fr) 70px; gap: 0.5rem; align-items: center;">
                        <div>
                            @highlight
                        </div>

                        <button type="button"
                                class="btn btn-sm btn-danger"
                                style="height: 31px; padding: 0; width: 100%;"
                                @onclick="() => RemoveHighlight(highlight)">
                            Remove
                        </button>
                    </div>
                }
            </div>
        }
    </fieldset>

    <div>
        <button type="button"
                class="btn btn-success mt-1"
                @onclick="AddJob">
            Add Job
        </button>
    </div>

    @if (JobAppliedState.Count > 0)
    {
        <fieldset class="border rounded p-3 pt-1 mt-3">
            <legend class="float-none w-auto px-2 fs-5">
                <strong>Job History</strong>
            </legend>

            @foreach (JobModel job in JobAppliedState)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h4 class="card-title">@job.OfficialJobTitle</h4>
                                <div>@job.Employer</div>

                                <div>
                                    @(job.IsRemote
                                        ? "Remote"
                                        : $"{job.City}, {job.State}")
                                </div>

                                <div>
                                    @job.StartDate?.ToString("MMM yyyy") -
                                    @(job.IsCurrentPosition
                                        ? "Present"
                                        : job.EndDate?.ToString("MMM yyyy"))
                                </div>
                            </div>

                            <div>
                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        style="height: 31px; padding: 0; width: 70px;"
                                        @onclick="() => RemoveJob(job)">
                                    Remove
                                </button>
                            </div>
                        </div>

                        <h5 class="mt-3">Highlights</h5>

                        <ul class="mb-0">
                            @foreach (string highlight in job.Highlights)
                            {
                                <li>@highlight</li>
                            }
                        </ul>

                        @if (job.Skills.Count > 0)
                        {
                            <h5 class="mt-3">Skills Used</h5>

                            <ul class="mb-0">
                                @foreach (SkillModel skill in job.Skills)
                                {
                                    <li>@skill.Name</li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            }
        </fieldset>
    }
</fieldset>

@if (_jobValidationModal)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Unable to <strong>Add</strong> @_jobValidationTarget
                    </h5>

                    <button type="button"
                            class="btn-close"
                            aria-label="Close"
                            @onclick="CloseJobValidationModal">
                    </button>
                </div>

                <div class="modal-body">
                    <p>Please complete or correct the following:</p>

                    <ul class="mb-0">
                        @foreach (string message in _jobValidationMessages)
                        {
                            <li>@message</li>
                        }
                    </ul>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="CloseJobValidationModal">
                        OK
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public List<JobModel>   JobAppliedState      { get; set; } = new List<JobModel>();
    [Parameter] public List<SkillModel> SkillAppliedState    { get; set; } = new List<SkillModel>();
    [Parameter] public List<SkillModel> JobSkillAppliedState { get; set; } = new List<SkillModel>();
    [Parameter] public EventCallback    JobApplied           { get; set; }

    private static readonly string[] States = ["AL", "AK", "AZ", "AR", "CA", "CO", "CT", "DE", "FL", "GA", "HI", "ID", "IL", "IN", "IA", "KS", "KY", "LA", "ME", "MD", "MA", "MI", "MN", "MS", "MO", "MT", "NE", "NV", "NH", "NJ", "NM", "NY", "NC", "ND", "OH", "OK", "OR", "PA", "RI", "SC", "SD", "TN", "TX", "UT", "VT", "VA", "WA", "WV", "WI", "WY", "DC"];

    private readonly JobModel      _jobEditState          = new JobModel();
    private readonly JobValidation _jobValidation         = new JobValidation();
    private readonly List<string>  _jobValidationMessages = new List<string>();

    private bool   _jobValidationModal  = false;
    private string _jobValidationTarget = string.Empty;

    private void CloseJobValidationModal()
    { _jobValidationModal = false; }

    private async Task AddJob()
    {
        _jobValidationTarget = "Job";

        #region - Validation
        _jobEditState.Skills.Clear();
        _jobEditState.Skills.AddRange(JobSkillAppliedState);

        _jobValidationMessages.Clear();
        _jobValidationMessages.AddRange(_jobValidation.Validate(_jobEditState));

        if (_jobValidationMessages.Count > 0)
        {
            _jobValidationModal = true;

            return;
        }
        #endregion

        #region - Save Applied State (Job)
        JobModel job = new JobModel
        {
            Employer          = _jobEditState.Employer.Trim(),
            City              = _jobEditState.IsRemote ? string.Empty : _jobEditState.City.Trim(),
            State             = _jobEditState.IsRemote ? string.Empty : _jobEditState.State,
            IsRemote          = _jobEditState.IsRemote,
            OfficialJobTitle  = _jobEditState.OfficialJobTitle.Trim(),
            StartDate         = _jobEditState.StartDate,
            EndDate           = _jobEditState.EndDate,
            IsCurrentPosition = _jobEditState.IsCurrentPosition,
            Highlights        = new List<string>(_jobEditState.Highlights),
            Skills            = new List<SkillModel>(JobSkillAppliedState)
        };
        JobAppliedState.Add(job);

        await JobApplied.InvokeAsync();
        #endregion

        #region - Clear Edit State (All)
        _jobEditState.Employer          = string.Empty;
        _jobEditState.City              = string.Empty;
        _jobEditState.State             = string.Empty;
        _jobEditState.IsRemote          = false;
        _jobEditState.OfficialJobTitle  = string.Empty;
        _jobEditState.StartDate         = null;
        _jobEditState.EndDate           = null;
        _jobEditState.IsCurrentPosition = false;
        _jobEditState.Highlight         = string.Empty;
        _jobEditState.Highlights.Clear();
        #endregion
    }

    private void RemoveJob(JobModel job)
    { JobAppliedState.Remove(job); }

    private void AddHighlight()
    {
        if (string.IsNullOrWhiteSpace(_jobEditState.Highlight))
        {
            _jobValidationMessages.Clear();
            _jobValidationMessages.Add("Highlight is required.");
            _jobValidationTarget = "Highlight";
            _jobValidationModal  = true;

            return;
        }

        _jobEditState.Highlights.Add(_jobEditState.Highlight.Trim());
        _jobEditState.Highlight = string.Empty;
    }

    private void RemoveHighlight(string highlight)
    { _jobEditState.Highlights.Remove(highlight); }

    private void CurrentPositionChanged()
    {
        if (_jobEditState.IsCurrentPosition)
        { _jobEditState.EndDate = null; }
    }

    private void RemoteChanged()
    {
        if (_jobEditState.IsRemote)
        {
            #region - Clear Edit State (City/State)
            _jobEditState.City  = string.Empty;
            _jobEditState.State = string.Empty;
            #endregion
        }
    }
}