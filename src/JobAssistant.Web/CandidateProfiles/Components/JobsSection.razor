<h2>Work Experience</h2>

<div class="mb-3">
    <label class="form-label" for="employer">Employer</label>
    <input id="employer"
           class="form-control"
           type="text"
           @bind="_jobEditState.Employer" />
</div>

<div class="mb-3">
    <label class="form-label" for="city">City</label>
    <input id="city"
           class="form-control"
           type="text"
           disabled="@_jobEditState.IsRemote"
           @bind="_jobEditState.City" />
</div>

<div class="mb-3">
    <label class="form-label" for="state">State</label>
    <select id="state"
            class="form-select"
            disabled="@_jobEditState.IsRemote"
            @bind="_jobEditState.State">
        <option value="">Select State</option>
        <option value="AL">AL</option>
        <option value="AK">AK</option>
        <option value="AZ">AZ</option>
        <option value="AR">AR</option>
        <option value="CA">CA</option>
        <option value="CO">CO</option>
        <option value="CT">CT</option>
        <option value="DE">DE</option>
        <option value="FL">FL</option>
        <option value="GA">GA</option>
        <option value="HI">HI</option>
        <option value="ID">ID</option>
        <option value="IL">IL</option>
        <option value="IN">IN</option>
        <option value="IA">IA</option>
        <option value="KS">KS</option>
        <option value="KY">KY</option>
        <option value="LA">LA</option>
        <option value="ME">ME</option>
        <option value="MD">MD</option>
        <option value="MA">MA</option>
        <option value="MI">MI</option>
        <option value="MN">MN</option>
        <option value="MS">MS</option>
        <option value="MO">MO</option>
        <option value="MT">MT</option>
        <option value="NE">NE</option>
        <option value="NV">NV</option>
        <option value="NH">NH</option>
        <option value="NJ">NJ</option>
        <option value="NM">NM</option>
        <option value="NY">NY</option>
        <option value="NC">NC</option>
        <option value="ND">ND</option>
        <option value="OH">OH</option>
        <option value="OK">OK</option>
        <option value="OR">OR</option>
        <option value="PA">PA</option>
        <option value="RI">RI</option>
        <option value="SC">SC</option>
        <option value="SD">SD</option>
        <option value="TN">TN</option>
        <option value="TX">TX</option>
        <option value="UT">UT</option>
        <option value="VT">VT</option>
        <option value="VA">VA</option>
        <option value="WA">WA</option>
        <option value="WV">WV</option>
        <option value="WI">WI</option>
        <option value="WY">WY</option>
        <option value="DC">DC</option>
    </select>
</div>

<div class="form-check mb-3">
    <input id="remote"
           class="form-check-input"
           type="checkbox"
           @bind="_jobEditState.IsRemote"
           @bind:after="RemoteChanged" />

    <label class="form-check-label" for="remote">
        Remote
    </label>
</div>

<div class="mb-3">
    <label class="form-label" for="officialJobTitle">Official Job Title</label>
    <input id="officialJobTitle"
           class="form-control"
           type="text"
           @bind="_jobEditState.OfficialJobTitle" />
</div>

<div class="mb-3">
    <label class="form-label" for="startDate">Start Date</label>
    <input id="startDate"
           class="form-control"
           type="month"
           @bind="_jobEditState.StartDate"
           @bind:format="yyyy-MM" />
</div>

<div class="mb-3">
    <label class="form-label" for="endDate">End Date</label>
    <input id="endDate"
           class="form-control"
           type="month"
           disabled="@_jobEditState.IsCurrentPosition"
           @bind="_jobEditState.EndDate"
           @bind:format="yyyy-MM" />
</div>

<div class="form-check">
    <input id="currentPosition"
           class="form-check-input"
           type="checkbox"
           @bind="_jobEditState.IsCurrentPosition"
           @bind:after="CurrentPositionChanged" />

    <label class="form-check-label" for="currentPosition">
        Current Position
    </label>
</div>

<hr class="my-4" />

<h3>Responsibilities</h3>

<div class="mb-3">
    <label class="form-label" for="responsibility">Responsibility</label>
    <textarea id="responsibility"
              class="form-control"
              rows="3"
              @bind="_jobEditState.Responsibility">
    </textarea>
</div>

<button type="button"
        class="btn btn-secondary"
        @onclick="AddResponsibility">
    Add Responsibility
</button>

@if (_jobEditState.Responsibilities.Count > 0)
{
    <table class="table mb-0">
        <tbody>
            @foreach (string responsibility in _jobEditState.Responsibilities)
            {
                <tr>
                    <td>@responsibility</td>
                    <td style="width: 1%">
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                @onclick="() => RemoveResponsibility(responsibility)">
                            Remove
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<hr class="my-4" />

<h3>Achievements</h3>

<div class="mb-3">
    <label class="form-label" for="achievement">Achievement</label>
    <textarea id="achievement"
              class="form-control"
              rows="3"
              @bind="_jobEditState.Achievement">
    </textarea>
</div>

<button type="button"
        class="btn btn-secondary"
        @onclick="AddAchievement">
    Add Achievement
</button>

@if (_jobEditState.Achievements.Count > 0)
{
    <table class="table mb-0">
        <tbody>
            @foreach (string achievement in _jobEditState.Achievements)
            {
                <tr>
                    <td>@achievement</td>
                    <td style="width: 1%">
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                @onclick="() => RemoveAchievement(achievement)">
                            Remove
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<hr class="my-4" />

<h3>Skills Used</h3>

@if (Skills.Count == 0)
{
    <p class="text-muted">
        Add Candidate Profile Skills before selecting skills used in this role.
    </p>
}
else
{
    @foreach (SkillModel skill in Skills)
    {
        <div class="form-check">
            <input class="form-check-input"
                   type="checkbox"
                   id="@($"jobSkill-{skill.Name}")"
                   checked="@_jobEditState.Skills.Contains(skill)"
                   @onchange="eventArgs => JobSkillSelectionChanged(skill, eventArgs)" />

            <label class="form-check-label"
                   for="@($"jobSkill-{skill.Name}")">
                @skill.Name
            </label>
        </div>
    }
}

<hr class="my-4" />

<div>
    <button type="button"
            class="btn btn-secondary"
            @onclick="AddJob">
        Add Job
    </button>
</div>

<hr class="my-4" />

@if (JobAppliedState.Count > 0)
{
    <h3>Job History</h3>

    @foreach (JobModel job in JobAppliedState)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">@job.OfficialJobTitle</h4>
                        <div>@job.Employer</div>

                        <div>
                            @(job.IsRemote
                                ? "Remote"
                                : $"{job.City}, {job.State}")
                        </div>

                        <div>
                            @job.StartDate?.ToString("MMM yyyy") -
                            @(job.IsCurrentPosition
                                ? "Present"
                                : job.EndDate?.ToString("MMM yyyy"))
                        </div>
                    </div>

                    <div>
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                @onclick="() => RemoveJob(job)">
                            Remove
                        </button>
                    </div>
                </div>

                <h5 class="mt-3">Responsibilities</h5>

                <ul class="mb-0">
                    @foreach (string responsibility in job.Responsibilities)
                    {
                        <li>@responsibility</li>
                    }
                </ul>

                @if (job.Achievements.Count > 0)
                {
                    <h5 class="mt-3">Achievements</h5>

                    <ul class="mb-0">
                        @foreach (string achievement in job.Achievements)
                        {
                            <li>@achievement</li>
                        }
                    </ul>
                }

                @if (job.Skills.Count > 0)
                {
                    <h5 class="mt-3">Skills Used</h5>

                    <ul class="mb-0">
                        @foreach (SkillModel skill in job.Skills)
                        {
                            <li>@skill.Name</li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
}

<hr class="my-4" />

@if (_jobValidationModal)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Unable to <strong>Add</strong> Job
                    </h5>

                    <button type="button"
                            class="btn-close"
                            aria-label="Close"
                            @onclick="CloseJobValidationModal">
                    </button>
                </div>

                <div class="modal-body">
                    <p>Please correct the following:</p>

                    <ul class="mb-0">
                        @foreach (string message in _jobValidationMessages)
                        {
                            <li>@message</li>
                        }
                    </ul>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="CloseJobValidationModal">
                        OK
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public List<JobModel> JobAppliedState { get; set; } = new List<JobModel>();
    [Parameter] public List<SkillModel>          Skills                     { get; set; } = new List<SkillModel>();

    private readonly JobModel      _jobEditState          = new JobModel();
    private readonly JobValidation _jobValidation         = new JobValidation();
    private readonly List<string>             _jobValidationMessages = new List<string>();

    private bool _jobValidationModal = false;

    private void CloseJobValidationModal()
    { _jobValidationModal = false; }

    private void AddJob()
    {
        #region - Validation
        _jobValidationMessages.Clear();
        _jobValidationMessages.AddRange(_jobValidation.Validate(_jobEditState));

        if (_jobValidationMessages.Count > 0)
        {
            _jobValidationModal = true;

            return;
        }
        #endregion

        JobModel job = new JobModel
        {
            Employer          = _jobEditState.Employer.Trim(),
            City              = _jobEditState.IsRemote ? string.Empty : _jobEditState.City.Trim(),
            State             = _jobEditState.IsRemote ? string.Empty : _jobEditState.State,
            IsRemote          = _jobEditState.IsRemote,
            OfficialJobTitle  = _jobEditState.OfficialJobTitle.Trim(),
            StartDate         = _jobEditState.StartDate,
            EndDate           = _jobEditState.EndDate,
            IsCurrentPosition = _jobEditState.IsCurrentPosition,
            Responsibilities  = new List<string>(_jobEditState.Responsibilities),
            Achievements      = new List<string>(_jobEditState.Achievements),
            Skills            = new List<SkillModel>(_jobEditState.Skills)
        };
        JobAppliedState.Add(job);

        #region - Clear Edit State (All)
        _jobEditState.Employer          = string.Empty;
        _jobEditState.City              = string.Empty;
        _jobEditState.State             = string.Empty;
        _jobEditState.IsRemote          = false;
        _jobEditState.OfficialJobTitle  = string.Empty;
        _jobEditState.StartDate         = null;
        _jobEditState.EndDate           = null;
        _jobEditState.IsCurrentPosition = false;
        _jobEditState.Responsibility    = string.Empty;
        _jobEditState.Achievement       = string.Empty;
        _jobEditState.Responsibilities.Clear();
        _jobEditState.Achievements.Clear();
        _jobEditState.Skills.Clear();
        #endregion
    }

    private void RemoveJob(JobModel job)
    { JobAppliedState.Remove(job); }

    private void AddResponsibility()
    {
        if (string.IsNullOrWhiteSpace(_jobEditState.Responsibility))
        { return; }

        _jobEditState.Responsibilities.Add(_jobEditState.Responsibility.Trim());
        _jobEditState.Responsibility = string.Empty;
    }

    private void RemoveResponsibility(string responsibility)
    { _jobEditState.Responsibilities.Remove(responsibility); }

    private void AddAchievement()
    {
        if (string.IsNullOrWhiteSpace(_jobEditState.Achievement))
        { return; }

        _jobEditState.Achievements.Add(_jobEditState.Achievement.Trim());
        _jobEditState.Achievement = string.Empty;
    }

    private void RemoveAchievement(string achievement)
    { _jobEditState.Achievements.Remove(achievement); }

    private void CurrentPositionChanged()
    {
        if (_jobEditState.IsCurrentPosition)
        { _jobEditState.EndDate = null; }
    }

    private void RemoteChanged()
    {
        if (_jobEditState.IsRemote)
        {
            #region - Clear Edit State (City/State)
            _jobEditState.City  = string.Empty;
            _jobEditState.State = string.Empty;
            #endregion
        }
    }

    private void JobSkillSelectionChanged(SkillModel skill, ChangeEventArgs eventArgs)
    {
        bool isSelected = eventArgs.Value is true;

        if (isSelected)
        {
            if (!_jobEditState.Skills.Contains(skill))
            { _jobEditState.Skills.Add(skill); }
        }
        else
        { _jobEditState.Skills.Remove(skill); }
    }
}